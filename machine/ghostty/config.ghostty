# Rich Tokyo Night colors, coordinated with Neovim.
theme = TokyoNight Night
background = #011628
foreground = #cbe0f0
selection-background = #275378
selection-foreground = #cbe0f0

# Exact installed family name, including Nerd Font icons.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
adjust-cell-height = 8%

# Room to breathe, with a subtle glass effect.
window-padding-x = 16
window-padding-y = 12
background-opacity = 0.96
background-blur = 20
window-theme = dark
macos-titlebar-style = transparent

cursor-style = block
cursor-style-blink = false
cursor-color = #7dcfff
